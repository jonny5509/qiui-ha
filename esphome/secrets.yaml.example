# Copy this file to esphome/secrets.yaml and fill in the values.
#
# Generate api_key with the ESPHome dashboard ("Encryption key") or:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

api_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"
ota_password: "REPLACE_WITH_A_PASSWORD"
wifi_ssid: "REPLACE_WITH_YOUR_WIFI"
wifi_password: "REPLACE_WITH_YOUR_WIFI_PASSWORD"
